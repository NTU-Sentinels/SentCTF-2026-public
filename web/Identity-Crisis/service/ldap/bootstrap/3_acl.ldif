dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to * by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage by * break
olcAccess: {1}to attrs=userPassword,shadowLastChange by self write by dn.exact="cn=admin,dc=NTU,dc=Sentinels" write by anonymous auth by * none
olcAccess: {2}to * by dn.exact="uid=keycloak-service,ou=service,dc=NTU,dc=Sentinels" read by self read by dn.exact="cn=admin,dc=NTU,dc=Sentinels" write by * none